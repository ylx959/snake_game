# Where the solo leaderboard lives. The only configuration the backend has.
#
#   sqlite:///./leaderboard.db    a file next to the server - the default
#   sqlite:///:memory:            nothing survives the process
#   postgresql://user@host/db     not built yet; see leaderboard/repository.py
#
# Postgres is deliberately a clear failure rather than a silent fall back to a
# local file: a deployed server quietly writing its scoreboard to a container's
# disk looks exactly like a working one until it restarts.
DATABASE_URL=sqlite:///./leaderboard.db

# The port uvicorn binds on 127.0.0.1. Defaults to 8000.
# PORT=8000
