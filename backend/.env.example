# Copy to backend/.env. Real values stay local; this file is committed.

# Where the leaderboard is. The default, used when this is unset, is a local
# file created on first run.
#   sqlite:///./leaderboard.db    a local file
#   sqlite:///:memory:            nothing survives the process
#   postgresql://user@host/db     the shared, deployed board
DATABASE_URL=sqlite:///./leaderboard.db

# Whether this process meant to play on the shared board. DATABASE_URL says
# where it is; this says you meant to play on it. Unset or 0 and a PostgreSQL
# URL is ignored in favour of the local file, so practice scores stay off the
# real table and do not spend a real nickname (a name in the visible top ten is
# reserved from everybody, including the player holding it).
#
# Deployments must set this to 1, or they write to their own container disk,
# which only looks durable until it restarts.
LEADERBOARD_REMOTE=0
